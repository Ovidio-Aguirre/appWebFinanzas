# Base de datos PostgreSQL (Docker local en puerto 5442 o Supabase/Neon en producción)
# IMPORTANTE: reemplaza <TU_CONTRASEÑA> por una contraseña segura. No versiones credenciales reales.
DATABASE_URL="postgresql://webfinanzas:<TU_CONTRASEÑA>@localhost:5442/webfinanzas_db?schema=public"
POSTGRES_PASSWORD="<TU_CONTRASEÑA>"

# Usuario único de la app (prototipo local). Reemplazar por autenticación real antes de desplegar.
SINGLE_USER_EMAIL="usuario@finanzapro.app"

# Configuración de Storage (Supabase Storage / S3 / Cloudinary / Local Fallback)
STORAGE_PROVIDER="local" # "supabase" | "s3" | "cloudinary" | "local"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_RECEIPTS_BUCKET="receipts"

# AWS S3 / MinIO Compatible
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="webfinanzas-receipts"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION="us-east-1"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Login de usuario unico. Genera hash y secreto con: node scripts/hash-password.mjs "tu-contrasena"
AUTH_USERNAME="tu-usuario"
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""
