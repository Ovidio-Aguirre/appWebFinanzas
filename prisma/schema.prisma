generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AccountType {
  CASH
  DEBIT
  CREDIT_CARD
  LOAN_LIABILITY
  SAVINGS_VAULT
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
}

enum TransactionType {
  PURCHASE
  BILL_PAYMENT
  CARD_PAYMENT
  LOAN_PAYMENT
  SALARY_INCOME
  REMITTANCE_INCOME
  TRANSFER
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum RuleType {
  SUBSCRIPTION
  PAYROLL
  REMITTANCE
  FIXED_FINANCING_INSTALLMENT
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  name              String
  avatarUrl         String?
  preferredCurrency String          @default("USD")
  locale            String          @default("es-MX")
  monthlyBudget     Decimal?        @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  accounts          Account[]
  transactions      Transaction[]
  recurringRules    RecurringRule[]
  savingsGoals      SavingsGoal[]

  @@index([email])
}

model Account {
  id                     String            @id @default(cuid())
  userId                 String
  name                   String
  institution            String?
  type                   AccountType
  currency               String            @default("USD")
  currentBalance         Decimal           @default(0) @db.Decimal(14, 2)
  color                  String?           @default("#0f766e")
  lastFourDigits         String?

  // Campos específicos para crédito / deuda (CREDIT_CARD y LOAN_LIABILITY)
  creditLimit            Decimal?          @db.Decimal(14, 2)
  cutoffDay              Int?              // Día de corte (1-31)
  paymentDueDay          Int?              // Día límite de pago (1-31)
  interestRate           Decimal?          @db.Decimal(6, 2) // Tasa de interés anual (%)
  noInterestPayment      Decimal?          @db.Decimal(14, 2) // Pago para no generar intereses
  minimumPayment         Decimal?          @db.Decimal(14, 2) // Pago mínimo del periodo
  originalPrincipal      Decimal?          @db.Decimal(14, 2) // Monto inicial para préstamos
  termMonths             Int?              // Plazo en meses para préstamos

  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  originTransactions     Transaction[]     @relation("OriginAccount")
  destinationTransactions Transaction[]    @relation("DestinationAccount")
  recurringRules         RecurringRule[]
  loanInstallments       LoanInstallment[]
  savingsGoals           SavingsGoal[]

  @@index([userId])
  @@index([userId, type])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  icon           String          @default("Receipt")
  color          String          @default("#0f766e")
  type           CategoryType
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@unique([name, type])
  @@index([type])
}

model Transaction {
  id                   String          @id @default(cuid())
  userId               String
  accountId            String
  categoryId           String
  destinationAccountId String?         // Para transferencias, ahorro o pagos de tarjeta/préstamo
  loanInstallmentId    String?         @unique // Si corresponde al pago de una cuota específica
  savingsGoalId        String?         // Si corresponde a un aporte a una meta de ahorro

  title                String
  description          String?
  amount               Decimal         @db.Decimal(14, 2)
  date                 DateTime        @default(now())
  transactionType      TransactionType
  receiptUrl           String?         // URL optimizada del ticket/comprobante/factura
  installmentsCount    Int?            @default(1) // Meses sin intereses o cuotas en TC
  currentInstallment   Int?            @default(1)
  isRecurring          Boolean         @default(false)
  isReconciled         Boolean         @default(false) // Cuadre con estado de cuenta bancario

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account         @relation("OriginAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount   Account?        @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  category             Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  loanInstallment      LoanInstallment? @relation(fields: [loanInstallmentId], references: [id], onDelete: SetNull)
  savingsGoal          SavingsGoal?    @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)

  @@index([userId, date(sort: Desc)])
  @@index([accountId, date(sort: Desc)])
  @@index([destinationAccountId])
  @@index([categoryId])
  @@index([transactionType])
  @@index([date])
}

model RecurringRule {
  id                String      @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String
  title             String
  provider          String?
  amount            Decimal     @db.Decimal(14, 2)
  frequency         Frequency
  startDate         DateTime
  nextExecutionDate DateTime
  lastExecutedDate  DateTime?
  autoPost          Boolean     @default(false)
  active            Boolean     @default(true)
  ruleType          RuleType

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, active])
  @@index([nextExecutionDate])
  @@index([accountId])
  @@index([categoryId])
}

model LoanInstallment {
  id                String            @id @default(cuid())
  accountId         String            // Asociada a la cuenta tipo LOAN_LIABILITY
  installmentNumber Int
  totalInstallments Int
  amount            Decimal           @db.Decimal(14, 2)
  capitalAmount     Decimal           @db.Decimal(14, 2)
  interestAmount    Decimal           @db.Decimal(14, 2)
  remainingBalance  Decimal           @default(0) @db.Decimal(14, 2)
  dueDate           DateTime
  paidAt            DateTime?
  status            InstallmentStatus @default(PENDING)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction       Transaction?

  @@unique([accountId, installmentNumber])
  @@index([accountId, dueDate])
  @@index([status, dueDate])
}

model SavingsGoal {
  id             String            @id @default(cuid())
  userId         String
  vaultAccountId String?           // Vinculado opcionalmente a una cuenta SAVINGS_VAULT
  name           String
  icon           String            @default("PiggyBank")
  color          String            @default("#0d9488")
  targetAmount   Decimal           @db.Decimal(14, 2)
  currentAmount  Decimal           @default(0) @db.Decimal(14, 2)
  deadline       DateTime?
  status         SavingsGoalStatus @default(ACTIVE)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultAccount   Account?          @relation(fields: [vaultAccountId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@index([userId, status])
  @@index([deadline])
}
